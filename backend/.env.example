# Copy this file to .env when configuring the API.
# MongoDB connection settings.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=farmer_to_customer

# Use a long random value outside local development.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated React development origins.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
